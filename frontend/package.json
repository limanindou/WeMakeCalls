    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.2",
    "@primeng/themes": "^19.0.0",
    "@stomp/stompjs": "^7.0.0",
    "chart.js": "^4.4.0",
    "express": "^5.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.0.0",
    "rxjs": "~7.8.0",
